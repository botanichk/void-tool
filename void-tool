def load_config():
    if not CONFIG_FILE.exists():
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(DEFAULT_CONFIG)

    try:
        import tomllib
    except ImportError:
        print("ERROR: Python >= 3.11 required (tomllib)", file=sys.stderr)
        sys.exit(1)

    with open(CONFIG_FILE, "rb") as f:
        return tomllib.load(f)


def run_script(script_name, extra_args=None, live=False):
    script_path = SCRIPTS_DIR / script_name
    if not script_path.exists():
        return {"rc": -1, "out": "", "err": f"Script not found: {script_path}"}

    cmd = [str(script_path)]
    if extra_args:
        cmd.extend(extra_args)

    try:
        safe_cwd = str(Path.home())
        timeout = 3600 if live else 600
        if live:
            r = subprocess.run(cmd, cwd=safe_cwd, timeout=timeout)
            return {"rc": r.returncode, "out": "", "err": ""}
        else:
            r = subprocess.run(cmd, capture_output=True, text=True, cwd=safe_cwd, timeout=timeout)
            return {"rc": r.returncode, "out": r.stdout, "err": r.stderr}
    except subprocess.TimeoutExpired:
        return {"rc": -1, "out": "", "err": f"Timeout ({timeout}s)"}
    except Exception as e:
        return {"rc": -1, "out": "", "err": str(e)}


def c(code, text):
    if not sys.stdout.isatty():
        return text
    return f"\033[{code}m{text}\033[0m"


gr = lambda t: c("32", t)
yl = lambda t: c("33", t)
rd = lambda t: c("31", t)
bl = lambda t: c("34", t)
bd = lambda t: c("1", t)


# ── update ──────────────────────────────────────────────

def cmd_update_status(args):
    config = load_config()
    modules = config.get("modules", {})

    print(f"\n{'Module':<20} {'Status':<16} {'Info'}")
    print("-" * 60)

    for name, mod in modules.items():
        if not mod.get("enabled", True):
            print(f"{name:<20} {yl('disabled'):<16}")
            continue

        result = run_script(mod["script"], ["--check"])
        info = result["out"].strip().split("\n")[-1] if result["out"] else ""
        info = info.replace("✅", "").replace("⬆️", "→").strip()

        if result["rc"] == 0:
            print(f"{name:<20} {gr('up-to-date'):<16} {info}")
        elif result["rc"] == 1:
            print(f"{name:<20} {rd('update avail'):<16} {info}")
        else:
            print(f"{name:<20} {rd('error'):<16} {result['err'].strip()}")


def cmd_update_check(args):
    config = load_config()
    modules = config.get("modules", {})
    any_updates = False

    for name, mod in modules.items():
        if not mod.get("enabled", True):
            continue

        print(f"• {name}... ", end="", flush=True)
        result = run_script(mod["script"], ["--check"])

        if result["rc"] == 0:
            print(gr("up-to-date"))
        elif result["rc"] == 1:
            info = result["out"].strip().split("\n")[-1]
            print(rd("update available"))
            print(f"  {info}")
            any_updates = True
        else:
            print(rd("error"))
            if result["err"]:
                print(f"  {result['err'].strip()}")

    if any_updates:
        print(f"\n{bl('→')} Run {bd(f'{TOOL_NAME} update')} to apply updates")
        return 1
    else:
        print(f"\n{gr('✓')} All modules up to date")
        return 0


def cmd_update_run(args):
    config = load_config()
    modules = config.get("modules", {})
    names = args.modules or list(modules.keys())

    for name in names:
        if name not in modules:
            print(rd(f"Unknown module: {name}"))
            continue
        if not modules[name].get("enabled", True):
            print(yl(f"Skipping disabled module: {name}"))
            continue
        if not modules[name].get("update", True):
            print(yl(f"Skipping install-only module: {name}"))
            continue

        print(f"\n{bl('⟳')} Updating {bd(name)}...")
        result = run_script(modules[name]["script"], live=True)

        if result["rc"] == 0:
            print(gr(f"✓ {name} updated successfully"))
        else:
            print(rd(f"✗ {name} update failed (exit {result['rc']})"))


# ── install ─────────────────────────────────────────────

def cmd_install(args):
    config = load_config()
    modules = config.get("modules", {})

    for name in args.packages:
        if name not in modules:
            print(rd(f"Unknown package: {name}"))
            continue
        if not modules[name].get("enabled", True):
            print(yl(f"Package disabled in config: {name}"))
            continue

        print(f"\n{bl('⟳')} Installing {bd(name)}...")
        result = run_script(modules[name]["script"], ["--install"], live=True)

        if result["rc"] == 0:
            print(gr(f"✓ {name} installed"))
        else:
            print(rd(f"✗ {name} install failed (exit {result['rc']})"))


# ── fix ─────────────────────────────────────────────────

def cmd_fix_health(args):
    """Check PipeWire stack health and restart if needed."""
    if KRS_BIN.exists():
        r = subprocess.run([str(KRS_BIN), "health"], capture_output=True, text=True, timeout=60)
        for line in r.stdout.split("\n"):
            if line.strip():
                print(f"  {line}")
        if r.returncode != 0:
            for line in r.stderr.split("\n"):
                if line.strip():
                    print(f"  {rd(line)}")
        return r.returncode

    print(f"  {bl('🔊')} Audio health check (Python fallback)...")

    RUNTIME_DIR = Path(f"/run/user/{os.getuid()}")
    PULSE_PID = RUNTIME_DIR / "pulse" / "pid"
    PULSE_SOCK = RUNTIME_DIR / "pulse" / "native"
    WP_LOG = Path("/tmp/void-tool-wp.log")

    def _running(prog, use_full=False):
        cmd = ["pgrep", "-x"] if not use_full else ["pgrep", "-f"]
        r = subprocess.run(cmd + [prog], capture_output=True, timeout=5)
        return r.returncode == 0

    def _kill_all():
        for sig in ["-15", "-9"]:
            subprocess.run(["pkill", sig, "-x", "wireplumber"],
                           capture_output=True, timeout=5)
            subprocess.run(["pkill", sig, "-f", r"pipewire.*pipewire-pulse"],
                           capture_output=True, timeout=5)
            subprocess.run(["pkill", sig, "-x", "pipewire"],
                           capture_output=True, timeout=5)
            time.sleep(1)

    def _start_stack():
        subprocess.Popen(["/usr/bin/pipewire"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(2)
        subprocess.Popen(["/usr/bin/wireplumber"],
                         stdout=subprocess.DEVNULL,
                         stderr=open(WP_LOG, "w"))
        time.sleep(1)
        subprocess.Popen(
            ["/usr/bin/pipewire", "-c", "/usr/share/pipewire/pipewire-pulse.conf"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _wait_for_pulse(timeout=15):
        for _ in range(timeout):
            time.sleep(1)
            r = subprocess.run(["pactl", "info"], capture_output=True, timeout=3)
            if r.returncode == 0:
                return True
        return False

    def _get_default_sink():
        r = subprocess.run(["pactl", "list", "short", "sinks"],
                           capture_output=True, text=True, timeout=5)
        for line in r.stdout.split("\n"):
            parts = line.strip().split()
            if len(parts) >= 2 and "auto_null" not in line:
                return parts[1]
        return None

    def _wp_is_stuck():
        if not WP_LOG.exists():
            return False
        log = WP_LOG.read_text()
        return "Unexpected reply" in log

    def _restart_dbus():
        dbus_pid = RUNTIME_DIR / "dbus.pid"
        if dbus_pid.exists():
            pid = dbus_pid.read_text().strip()
            subprocess.run(["kill", pid], capture_output=True, timeout=5)
            time.sleep(2)
        subprocess.Popen(["dbus-daemon", "--session",
                          "--address=unix:path=/run/user/1000/bus", "--nofork"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(10):
            time.sleep(0.5)
            r = subprocess.run(
                ["timeout", "2", "dbus-send", "--session",
                 "--dest=org.freedesktop.DBus", "--type=method_call",
                 "--print-reply", "/org/freedesktop/DBus",
                 "org.freedesktop.DBus.ListNames"],
                capture_output=True, timeout=5)
            if r.returncode == 0:
                return True
        return False

    def _restart_stack():
        _kill_all()
        for f in [PULSE_PID, PULSE_SOCK]:
            try:
                f.unlink(missing_ok=True)
            except OSError:
                pass

        _start_stack()

        if not _wait_for_pulse():
            if _wp_is_stuck():
                print(f"  {yl('⟳')} WirePlumber stuck on D-Bus — restarting session bus...")
                _kill_all()
                if not _restart_dbus():
                    return False
                _start_stack()
                if not _wait_for_pulse():
                    return False
            else:
                return False

        sink = _get_default_sink()
        if not sink:
            print(f"  {yl('⚠')} Pulse OK but no real sinks — waiting...")
            if not _wait_for_pulse(timeout=10):
                return False
            sink = _get_default_sink()
            if not sink:
                return False

        subprocess.run(["pactl", "set-default-sink", sink],
                       capture_output=True, timeout=5)
        subprocess.run(["pactl", "set-sink-volume", sink, "100%"],
                       capture_output=True, timeout=5)
        subprocess.run(["pactl", "set-sink-mute", sink, "0"],
                       capture_output=True, timeout=5)
        return True

    statuses = {
        "pipewire": _running("pipewire"),
        "wireplumber": _running("wireplumber"),
        "pipewire-pulse": _running("pipewire-pulse", use_full=True),
    }

    r = subprocess.run(["timeout", "3", "pactl", "info"], capture_output=True, timeout=5)
    statuses["pulse-socket"] = r.returncode == 0

    if all(statuses.values()) and _get_default_sink():
        print(f"  {gr('✓')} PipeWire stack healthy")
        return 0

    for name, ok in statuses.items():
        print(f"  {'  ' if ok else rd('✗')} {name}: {gr('running') if ok else rd('dead')}")

    print(f"  {yl('⟳')} Restarting audio stack...")
    if _restart_stack():
        print(f"  {gr('✓')} Audio stack restarted, HDMI default")
    else:
        print(f"  {rd('✗')} Audio restart failed — check manually")
        return 1

    return 0


# ── clean ───────────────────────────────────────────────

def cmd_clean(args):
    any_errors = False

    if "builds" in args.targets:
        print(f"• xbps-src clean... ", end="", flush=True)
        r = subprocess.run(
            [str(Path.home() / "void-packages" / "xbps-src"), "clean"],
            capture_output=True, text=True, timeout=300)
        if r.returncode == 0:
            print(gr("done"))
        else:
            print(rd("error"))
            print(f"  {r.stderr.strip()}")
            any_errors = True

    if "cache" in args.targets:
        cache_dirs = [
            (Path.home() / ".cache" / "pip", "pip"),
            (Path.home() / ".cache" / "thumbnails", "thumbnails"),
            (Path.home() / ".cache" / "mpv" / "chapters", "mpv chapters"),
            (Path.home() / ".cache" / "wireplumber", "wireplumber"),
        ]
        for d, label in cache_dirs:
            if d.exists():
                r = subprocess.run(["du", "-sb", str(d)], capture_output=True, text=True, timeout=30)
                size = int(r.stdout.split()[0]) if r.returncode == 0 else 0
                subprocess.run(["rm", "-rf", str(d)], capture_output=True, timeout=30)
                print(f"  {label}: {size / 1024**2:.1f} MB — {gr('cleaned')}")
            else:
                print(f"  {label}: {yl('empty')}")

    if "prefixes" in args.targets:
        prefixes = Path.home() / "PortProtonQt" / "prefixes"
        if prefixes.exists():
            r = subprocess.run(["du", "-sb", str(prefixes)], capture_output=True, text=True, timeout=30)
            size = int(r.stdout.split()[0]) if r.returncode == 0 else 0
            print(f"  Prefixes: {size / 1024**3:.1f} GB — {yl('skipped')} (rm manually)")
        else:
            print(f"  Prefixes: {yl('not found')}")

    if "kernels" in args.targets:
        return cmd_clean_kernels(args)

    return 1 if any_errors else 0


def cmd_clean_kernels(args):
    boot = Path("/boot")
    current = os.uname().release

    kernels = sorted(boot.glob("vmlinuz-*"), key=lambda p: p.stat().st_mtime)
    if not kernels:
        print(f"  {yl('ℹ')} No kernels found in /boot")
        return 0

    vkpurge_list = []
    r = subprocess.run(["vkpurge", "list"], capture_output=True, text=True, timeout=10)
    if r.returncode == 0:
        vkpurge_list = [v.strip() for v in r.stdout.strip().split("\n") if v.strip()]

    def _parse(v):
        parts = v.split(".")
        return (int(parts[0]), int(parts[1]), int(parts[2].split("_")[0]), int(parts[2].split("_")[1]))

    versions = []
    for k in kernels:
        ver = k.name[len("vmlinuz-"):]
        try:
            key = _parse(ver)
        except (IndexError, ValueError):
            continue
        series = f"{key[0]}.{key[1]}"
        versions.append((ver, key, series))

    versions.sort(key=lambda x: x[1])

    series_groups = {}
    for v, key, s in versions:
        series_groups.setdefault(s, []).append(v)

    protected = set()
    for s, vers in series_groups.items():
        vers_sorted = sorted(vers, key=_parse, reverse=True)
        for i, v in enumerate(vers_sorted):
            if i < 2 or v == current:
                protected.add(v)

    candidates = [v for v, _, _ in versions if v not in protected]
    # Also mark what vkpurge can handle
    vkpurge_candidates = set(vkpurge_list) & set(candidates)

    print(f"\n  {'#':<4} {'Версия':<18} {'Серия':<7} {'Размер':>7}  {'Статус'}")
    print(f"  {'─'*4} {'─'*18} {'─'*7} {'─'*7}  {'─'*14}")
    for i, (v, key, s) in enumerate(versions, 1):
        sz = next((k.stat().st_size for k in kernels if k.name == f"vmlinuz-{v}"), 0)
        if v == current:
            st = gr("← текущее")
        elif v in protected:
            st = gr("оставлено")
        elif v in vkpurge_candidates:
            st = rd("vkpurge")
        else:
            st = rd("вручную")
        print(f"  {i:<4} {v:<18} {s:<7} {sz/1024:>6.0f}K  {st}")

    print(f"\n  {bl('ℹ')} Защищено: {len(protected)} (2 последних в серии + текущее)")
    print(f"  {bl('ℹ')} К удалению: {len(candidates)} ({len(vkpurge_candidates)} через vkpurge)")
    if not candidates:
        print(f"  {gr('✓')} Нечего удалять")
        return 0

    if getattr(args, "dry_run", False):
        print(f"\n  {yl('⚠')} Пробный запуск — ничего не удалено")
        for v in candidates:
            print(f"     будет удалено: {v}")
        return 0

    print(f"\n  {bl('ℹ')} Введи номера через пробел или запятую. Пример: {'1 2 5'} или {'1-3'}")
    try:
        c = input(f"  {yl('Какие удалить?')} [1-{len(versions)}, a=все, q=выход]: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 1

    if c.lower() in ("q", ""):
        print(f"  {yl('ℹ')} Отменено")
        return 0
    elif c.lower() == "a":
        selected = candidates
    else:
        indices = set()
        for part in c.replace(",", " ").split():
            if "-" in part:
                lo, hi = part.split("-", 1)
                for n in range(int(lo), int(hi) + 1):
                    indices.add(n)
            else:
                indices.add(int(part))
        selected = []
        for i, (v, _, _) in enumerate(versions, 1):
            if i in indices and v in candidates:
                selected.append(v)

    if not selected:
        print(f"  {yl('ℹ')} Ничего не выбрано (защищённые ядра пропущены)")
        return 0

    print(f"  {yl('⟳')} Авторизация sudo...", end=" ", flush=True)
    r = subprocess.run(["sudo", "-v"], capture_output=True, timeout=30)
    if r.returncode != 0:
        print(rd("ошибка"))
        return 1
    print(gr("ок"))

    freed = 0
    for v in selected:
        if v in vkpurge_candidates:
            print(f"  ⟳ vkpurge rm {v}...", end=" ", flush=True)
            r = subprocess.run(["sudo", "vkpurge", "rm", v],
                               capture_output=True, text=True, timeout=120)
            if r.returncode == 0:
                print(gr("готово"))
            else:
                print(rd(f"ошибка: {r.stderr.strip()[:80]}"))
        else:
            print(f"  ⟳ rm {v}...", end=" ", flush=True)
            for pattern in ("vmlinuz", "initramfs", "config"):
                for f in boot.glob(f"{pattern}-{v}*"):
                    sz = f.stat().st_size
                    f.unlink()
                    freed += sz
            print(gr("готово"))

    if any(v not in vkpurge_candidates for v in selected):
        print(f"  ⟳ Обновление GRUB...", end=" ", flush=True)
        r = subprocess.run(["sudo", "grub-mkconfig", "-o", "/boot/grub/grub.cfg"],
                           capture_output=True, text=True, timeout=30)
        print(gr("готово") if r.returncode == 0 else rd(f"ошибка: {r.stderr.strip()[:80]}"))

    remain = sum(1 for v, _, _ in versions if boot.glob(f"vmlinuz-{v}*"))
    print(f"\n  {gr('✓')} Готово. Осталось ядер: {remain}")
    return 0


# ── trigger ─────────────────────────────────────────────

def cmd_trigger(args):
    config = load_config()
    interval = config.get("interval_days", 7)

    STATE_DIR.mkdir(parents=True, exist_ok=True)

    last_run = 0
    if STATE_FILE.exists():
        last_run = int(STATE_FILE.read_text().strip())

    now = int(time.time())
    elapsed = (now - last_run) / 86400

    if elapsed < interval:
        return 0

    print(f"{TOOL_NAME}: checking (last check {elapsed:.0f}d ago)")
    rc = cmd_update_check(args)

    if rc != 0:
        updates = []
        config = load_config()
        for name in config.get("modules", {}):
            result = run_script(config["modules"][name]["script"], ["--check"])
            if result["rc"] == 1:
                updates.append(name)
        if updates:
            subprocess.run(
                ["notify-send", "--icon=software-update-available",
                 f"{TOOL_NAME}: updates available",
                 ", ".join(updates)],
                capture_output=True, timeout=5)

    STATE_FILE.write_text(str(now))
    return rc


