def cmd_info(args):
    hostname = os.uname().nodename
    kernel = os.uname().release
    uptime_sec = float(open("/proc/uptime").read().split()[0])
    days = int(uptime_sec / 86400)
    hours = int((uptime_sec % 86400) / 3600)
    mins = int((uptime_sec % 3600) / 60)

    def _u():
        if days: return f"{days}д {hours}ч"
        if hours: return f"{hours}ч {mins}мин"
        return f"{mins}мин"

    print(f"  {bl('void-tool info')} — {hostname}")
    print(f"  {'─' * 42}")
    print(f"  Ядро:        {kernel}")
    print(f"  Система:     {_u()}")

    mem = {}
    for line in open("/proc/meminfo"):
        parts = line.split()
        mem[parts[0].rstrip(":")] = int(parts[1])
    total = mem["MemTotal"] / 1024**2
    avail = mem["MemAvailable"] / 1024**2
    print(f"  Память:      {avail:.1f}/{total:.1f} GB")

    r = subprocess.run(["df", "-h", "/"], capture_output=True, text=True, timeout=5)
    _, size, used, free, *_ = r.stdout.strip().split("\n")[1].split()
    print(f"  Диск (/):    {used} / {size}  (свободно {free})")

    boot = Path("/boot")
    is_separate = subprocess.run(
        ["findmnt", "-n", "-o", "SOURCE", str(boot)],
        capture_output=True, text=True, timeout=5
    ).stdout.strip()
    if is_separate:
        r = subprocess.run(["df", "-h", str(boot)], capture_output=True, text=True, timeout=5)
        _, bsize, bused, bfree, *_ = r.stdout.strip().split("\n")[1].split()
        print(f"  /boot:       {bused} / {bsize}  (свободно {bfree})")

    kernels = sorted(boot.glob("vmlinuz-*"), key=lambda p: p.stat().st_mtime)
    current = os.uname().release
    cur = next((i + 1 for i, k in enumerate(kernels) if current in k.name), 0)
    print(f"  Ядер:        {len(kernels)} в /boot (текущее #{cur})")

    def _running(prog, full=False):
        r = subprocess.run(["pgrep", "-f" if full else "-x", prog], capture_output=True, timeout=3)
        return r.returncode == 0

    def _sym(v): return gr("✅") if v else rd("❌")
    pw = _running("pipewire")
    wp = _running("wireplumber")
    pp = _running("pipewire-pulse", full=True)
    r2 = subprocess.run(["timeout", "2", "pactl", "info"], capture_output=True, timeout=5)
    ps = r2.returncode == 0
    print(f"  Audio:       PW {_sym(pw)} WP {_sym(wp)} PP {_sym(pp)} pulse {_sym(ps)}")

    if shutil.which("nvidia-smi"):
        r = subprocess.run(["nvidia-smi", "--query-gpu=driver_version,temperature.gpu,name", "--format=csv,noheader"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            print(f"  NVIDIA:      {r.stdout.strip()}")

    return 0


