# ── self-install ─────────────────────────────────────────

def cmd_self_install(args):
    """Install void-tool from repo clone to ~/void-tool/."""
    repo_dir = Path(args.source).resolve()
    scripts_src = repo_dir / "scripts"
    krs_src = repo_dir / "krs"

    if not (repo_dir / "void-tool").exists():
        print(rd(f"✗ void-tool not found in {repo_dir}"))
        return 1

    print(f"  {bl('⟳')} Installing void-tool from {repo_dir}...")

    # 1. create ~/void-tool/ and copy main script
    tool_dir = Path.home() / "void-tool"
    tool_dir.mkdir(parents=True, exist_ok=True)
    dest_script = tool_dir / "void-tool"
    if repo_dir.resolve() != tool_dir.resolve():
        shutil.copy2(str(repo_dir / "void-tool"), str(dest_script))
        dest_script.chmod(0o755)
        print(f"  ✓ {gr('void-tool')} → {tool_dir}")
    else:
        print(f"  ✓ {gr('void-tool')} already in {tool_dir}")

    # 2. copy scripts
    if scripts_src.exists() and repo_dir.resolve() != tool_dir.resolve():
        dest_scripts = tool_dir / "scripts"
        dest_scripts.mkdir(parents=True, exist_ok=True)
        for f in scripts_src.glob("*.sh"):
            shutil.copy2(str(f), str(dest_scripts / f.name))
            (dest_scripts / f.name).chmod(0o755)
            print(f"  ✓ {f.name} → {dest_scripts}")

        templates_src = repo_dir / "templates"
        if templates_src.exists():
            dest_templates = dest_scripts / "templates"
            if dest_templates.exists():
                shutil.rmtree(str(dest_templates))
            shutil.copytree(str(templates_src), str(dest_templates))
            print(f"  ✓ templates → {dest_templates}")

    # 3. build and install krs
    if krs_src.exists():
        cargo = shutil.which("cargo")
        if cargo:
            print(f"  {bl('⟳')} Building krs (Rust)...")
            r = subprocess.run(
                [cargo, "build", "--release"],
                cwd=str(krs_src), capture_output=True, text=True, timeout=180)
            if r.returncode == 0:
                built = krs_src / "target" / "release" / "krs"
                if built.exists():
                    shutil.copy2(str(built), str(tool_dir / "krs"))
                    (tool_dir / "krs").chmod(0o755)
                    print(f"  ✓ krs (Rust) → {tool_dir}")
            else:
                print(f"  {yl('⚠')} krs build failed — install cargo and run manually")
                print(f"     cd {krs_src} && cargo build --release && cp target/release/krs {tool_dir}/")
        else:
            print(f"  {yl('⚠')} cargo not found — install rustup first, then build krs manually")
            print(f"     cd {krs_src} && cargo build --release && cp target/release/krs {tool_dir}/")

    # 4. create default config
    if not CONFIG_FILE.exists():
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_FILE.write_text(DEFAULT_CONFIG)
        print(f"  ✓ config → {CONFIG_FILE}")
    else:
        print(f"  ✓ config exists → {CONFIG_FILE}")

    # 5. symlink ~/.local/bin/void-tool → ~/void-tool/void-tool
    local_bin = Path.home() / ".local" / "bin"
    local_bin.mkdir(parents=True, exist_ok=True)
    link = local_bin / "void-tool"
    link.unlink(missing_ok=True)
    link.symlink_to(str(dest_script))
    print(f"  ✓ symlink → {link}")

    # 6. install completions
    cmd_completions(argparse.Namespace(shell="install"))

    print(f"\n  {gr('✓')} void-tool installed in {tool_dir}")
    print(f"     symlink: {link}")
    print(f"     run: void-tool --version")
    return 0


