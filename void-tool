SEARCH_SOURCES = {"xbps", "flatpak", "appimage", "all"}

def _search_xbps(query, out, installable):
    r = subprocess.run(["xbps-query", "-Rs", query], capture_output=True, text=True, timeout=15)
    if r.returncode != 0 or not r.stdout.strip():
        r = subprocess.run(["xbps-query", "-Rs", f"*{query}*"], capture_output=True, text=True, timeout=15)
    pkgs = []
    for line in r.stdout.strip().split("\n"):
        line = line.strip()
        if not line:
            continue
        rest = line[4:].strip() if len(line) > 4 else line
        parts = rest.split(None, 1)
        if len(parts) < 2:
            continue
        name_ver, desc = parts[0], parts[1]
        idx = name_ver.rfind("-")
        if idx > 0:
            name = name_ver[:idx]
            ver = name_ver[idx+1:]
            pkgs.append((name, ver, desc))
    if not pkgs:
        out.append((f"  {yl('ℹ')} Нет совпадений в xbps", None, None))
        return
    out.append((gr(f"  ═══ xbps ({len(pkgs)} совпадений) ═══"), None, None))
    for name, ver, desc in pkgs[:20]:
        installable.append(("xbps", name, f"{name}  {ver}  {desc}"))
        out.append((f"  {name:<30} {ver:<16} {desc}", "xbps", name))
    if len(pkgs) > 20:
        out.append((f"  {yl('...и ещё')} {len(pkgs)-20}", None, None))


def _search_flatpak(query, out, installable):
    if not shutil.which("flatpak"):
        out.append((f"  {yl('ℹ')} flatpak не установлен", None, None))
        return
    r = subprocess.run(["flatpak", "search", query], capture_output=True, text=True, timeout=15)
    lines = r.stdout.strip().split("\n")
    if len(lines) <= 1:
        out.append((f"  {yl('ℹ')} Нет совпадений в flatpak", None, None))
        return
    out.append((gr(f"  ═══ flatpak ({len(lines)-1} совпадений) ═══"), None, None))
    header = True
    for line in lines:
        if header:
            header = False
            continue
        parts = line.split("\t")
        if len(parts) >= 6:
            name = parts[0]
            desc = parts[1]
            app_id = parts[2]
            ver = parts[3]
            installable.append(("flatpak", app_id, f"{app_id}  {ver}  {name}"))
            out.append((f"  {app_id:<40} {ver:<12} {name}", "flatpak", app_id))


def _search_appimage_local(query, out, installable):
    dirs = [Path.home() / "Applications", Path.home() / "AppImages",
            Path.home() / ".local" / "bin"]
    found = []
    for d in dirs:
        if d.exists():
            for f in d.glob("*.AppImage"):
                if query.lower() in f.stem.lower():
                    found.append(f)
    if found:
        out.append((gr(f"  ═══ appimage (локальные) ═══"), None, None))
        for f in found:
            sz = f.stat().st_size / 1024**2
            installable.append(("appimage-lokal", str(f), f.name))
            out.append((f"  {f.stem:<30} {sz:.0f}M", "appimage-lokal", str(f)))


def _search_appimage_hub(query, out, installable):
    try:
        r = subprocess.run(
            ["curl", "-sL", "--max-time", "8",
             "https://appimage.github.io/feed.json"],
            capture_output=True, text=True, timeout=12)
        if r.returncode != 0:
            out.append((f"  {yl('ℹ')} AppImageHub недоступен", None, None))
            return
        import json
        data = json.loads(r.stdout)
        hits = []
        for item in data.get("items", []):
            name = item.get("name", "")
            desc = item.get("description", "") or ""
            if query.lower() in name.lower() or query.lower() in desc.lower():
                hits.append((name, desc, item.get("categories", "")))
        if hits:
            out.append((gr(f"  ═══ AppImageHub ({len(hits)} совпадений) ═══"), None, None))
            for name, desc, cat in hits[:15]:
                installable.append(("appimage", name, f"{name}  {desc[:60]}"))
                out.append((f"  {name:<30} {desc[:60]}", "appimage", name))
            if len(hits) > 15:
                out.append((f"  {yl('...и ещё')} {len(hits)-15}", None, None))
        else:
            out.append((f"  {yl('ℹ')} Нет совпадений в AppImageHub", None, None))
    except Exception:
        out.append((f"  {yl('ℹ')} AppImageHub недоступен", None, None))


def _install_selected(source, name):
    if source == "xbps":
        print(f"  {yl('⟳')} xbps-install {name}...")
        r = subprocess.run(["sudo", "-v"], capture_output=True, timeout=30)
        if r.returncode != 0:
            print(f"  {rd('✗')} Нужен sudo: sudo xbps-install -y {name}")
            return
        r = subprocess.run(["sudo", "xbps-install", "-y", name],
                           capture_output=True, text=True, timeout=120)
        if r.returncode == 0:
            print(f"  {gr('✓')} {name} установлен")
        else:
            print(f"  {rd('✗')} Ошибка: {r.stderr.strip()[:100]}")
    elif source == "flatpak":
        print(f"  {yl('⟳')} flatpak install {name}...")
        r = subprocess.run(["flatpak", "install", "-y", name],
                           capture_output=True, text=True, timeout=120)
        if r.returncode == 0:
            print(f"  {gr('✓')} {name} установлен")
        else:
            print(f"  {rd('✗')} Ошибка: {r.stderr.strip()[:100]}")
    elif source == "appimage":
        print(f"  {yl('ℹ')} AppImage: https://appimage.github.io/{name}/")
    elif source == "appimage-lokal":
        print(f"  {yl('ℹ')} Запусти: chmod +x '{name}' && '{name}'")


def cmd_search(args):
    if args.targets[0].lower() in SEARCH_SOURCES:
        source = args.targets[0].lower()
        query = " ".join(args.targets[1:])
    else:
        source = "all"
        query = " ".join(args.targets)

    if not query:
        print(f"  {yl('ℹ')} {TOOL_NAME} search [xbps|flatpak|appimage|all] <запрос>")
        return 0

    out = []
    installable = []
    searched = []
    if source in ("xbps", "all"):
        _search_xbps(query, out, installable)
        searched.append("xbps")
    if source in ("flatpak", "all"):
        _search_flatpak(query, out, installable)
        searched.append("flatpak")
    if source in ("appimage", "all"):
        _search_appimage_local(query, out, installable)
        _search_appimage_hub(query, out, installable)
        searched.append("appimage")

    for block in out:
        print(block[0])

    if not installable:
        return 0

    while True:
        try:
            c = input(f"\n  {yl('Установить?')} [1-{len(installable)}, q=нет]: ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if c.lower() in ("q", ""):
            break
        try:
            idx = int(c) - 1
            if 0 <= idx < len(installable):
                src, name, label = installable[idx]
                print(f"  {bl('⟳')} Установка: {label}")
                _install_selected(src, name)
            else:
                print(f"  {rd('Введите число от 1 до')} {len(installable)}")
        except ValueError:
            print(f"  {rd('Введите число')}")
    return 0


